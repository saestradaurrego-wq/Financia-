rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Financia stores each account's financial state under its Firebase Auth UID.
    match /users/{userId}/finance/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Deny all other document paths unless explicitly authorized above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
